<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and transfer rules for Android 12 and above.

    Both routes are excluded, and they are separate decisions:

    `cloud-backup` is Android Auto Backup, which copies app data to the user's
    Google Drive. That is app data leaving the device to a server, which is
    exactly what "the app stays local" rules out. Neither specification asks for
    it, so it is off.

    `device-transfer` is a direct phone-to-phone copy during setup and never
    touches a server, so it is a closer call. It is still excluded, for two
    reasons. The stored wallpaper references are `content://` URIs backed by
    persisted permission grants that do not survive the move, so they would
    arrive as references the new device cannot open. And the rest — session
    history, blocked apps, pinned and recently opened apps — is a behavioural
    record that the specifications never asked to move anywhere. On Android 12
    and above `android:allowBackup="false"` does not by itself disable
    device-to-device transfer, so this block is what actually decides it.

    The cost, stated plainly: nothing here follows you to a new phone. See
    docs/PRIVACY.md, which says so to the user in the same words.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="device_root" path="." />
        <exclude domain="device_file" path="." />
        <exclude domain="device_database" path="." />
        <exclude domain="device_sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
